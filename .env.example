# ─────────────────────────────────────────────────────────────
# Recruitment Intelligence Copilot — környezeti változók
# Másold át .env-be:  cp .env.example .env   és töltsd ki.
# ─────────────────────────────────────────────────────────────

# 🧠 AGY — Claude API kulcs. Enélkül a rendszer DEMO-módban fut
# (realisztikus HU minta-outputok), de nem "gondolkodik" élesben.
ANTHROPIC_API_KEY=

# Melyik modell hajtsa a capability-ket. Erős default: senior ítélethez.
# Alternatívák: claude-fable-5 (legerősebb), claude-opus-4-8, claude-haiku-4-5-20251001
CLAUDE_MODEL=claude-sonnet-5

# 📡 ELÉRÉS — Firecrawl kulcs a publikus-web scrapinghez.
# Enélkül a Reach Engine a szintetikus jelölt-poolt használja.
# Kulcs: https://www.firecrawl.dev  (Bearer token, "fc-...")
FIRECRAWL_API_KEY=
FIRECRAWL_BASE=https://api.firecrawl.dev/v1

# Reach Engine viselkedés
REACH_SEARCH_LIMIT=6       # találat / keresési lekérdezés
REACH_SCRAPE_TOP=6         # hány publikus URL-t scrapeljünk mélyen
REACH_DEFAULT_SOURCE=auto  # auto | firecrawl | synthetic

# Web-app port
PORT=5178
