#!/bin/bash
# ─────────────────────────────────────────────────────────────
# Titok-őr: megakadályozza, hogy valódi API kulcs commitba kerüljön.
#
# Bekapcsolás (repónként egyszer):
#     git config core.hooksPath .githooks
#
# Szándékos átlépés (csak ha biztosan tudod, mit csinálsz):
#     git commit --no-verify
# ─────────────────────────────────────────────────────────────
set -uo pipefail

RED=$'\033[31m'; YEL=$'\033[33m'; RST=$'\033[0m'
fail=0

# 1) Élő kulcs-formátumok a staged tartalomban.
#    Csak nagy-biztonságú minták, hogy a placeholderek ne adjanak fals riasztást.
PATTERNS=(
  'sk-ant-api[0-9]{2}-[A-Za-z0-9_-]{40,}'   # Anthropic
  'fc-[a-f0-9]{32}'                          # Firecrawl
  'sk-proj-[A-Za-z0-9_-]{40,}'               # OpenAI (project)
  'sk-[A-Za-z0-9]{48}'                       # OpenAI (klasszikus)
  'gh[pousr]_[A-Za-z0-9]{36}'                # GitHub token
  'github_pat_[A-Za-z0-9_]{60,}'             # GitHub fine-grained PAT
  'AKIA[0-9A-Z]{16}'                         # AWS access key id
  'AIza[0-9A-Za-z_-]{35}'                    # Google API key
  'xox[baprs]-[A-Za-z0-9-]{20,}'             # Slack
  '-----BEGIN [A-Z ]*PRIVATE KEY-----'       # privát kulcs
)
JOINED=$(IFS='|'; echo "${PATTERNS[*]}")

while IFS= read -r file; do
  [ -n "$file" ] || continue
  # bináris fájlokat kihagyjuk
  git show ":$file" 2>/dev/null | grep -qaI . || continue
  hits=$(git show ":$file" 2>/dev/null | grep -aoE "$JOINED" | sort -u)
  if [ -n "$hits" ]; then
    fail=1
    echo "${RED}✖ VALÓDI KULCSNAK TŰNŐ ÉRTÉK:${RST} $file"
    while IFS= read -r h; do
      echo "    → ${h:0:16}…  (${#h} karakter)"
    done <<< "$hits"
  fi
done < <(git diff --cached --name-only --diff-filter=ACM)

# 2) Maga a .env soha ne legyen staged.
if git diff --cached --name-only --diff-filter=ACM | grep -qE '(^|/)\.env$'; then
  fail=1
  echo "${RED}✖ A .env fájl staged!${RST} Ennek soha nem szabad verziókövetettnek lennie."
fi

# 3) A .env.example-ben csak placeholder állhat — kulcs-mezők ne legyenek kitöltve.
if git diff --cached --name-only --diff-filter=ACM | grep -qE '(^|/)\.env\.example$'; then
  bad=$(git show ":.env.example" 2>/dev/null \
        | grep -nE '^[A-Z_]*(KEY|TOKEN|SECRET|PASSWORD)[A-Z_]*=.+' \
        | grep -vE '=\s*<' || true)
  if [ -n "$bad" ]; then
    fail=1
    echo "${RED}✖ A .env.example kulcs-mezője ki van töltve:${RST}"
    echo "$bad" | sed 's/^/    /'
    echo "${YEL}    Használj <szogletes-zarojeles> placeholdert helyette.${RST}"
  fi
fi

if [ "$fail" -ne 0 ]; then
  echo ""
  echo "${YEL}A commit blokkolva. Tedd a valódi értéket a .env-be (gitignore-olt),"
  echo "vagy ha téves riasztás:  git commit --no-verify${RST}"
  exit 1
fi
exit 0
